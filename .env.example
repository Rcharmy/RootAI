# Groq API
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Investigation defaults (match BudgetTracker defaults in state.py)
ROOTAI_MAX_STEPS=15
ROOTAI_MAX_COST_USD=0.10
ROOTAI_MAX_WALL_SECONDS=180

# Data paths
ROOTAI_DUCKDB_PATH=data/processed/olist.duckdb
ROOTAI_CHROMA_PATH=data/chroma
ROOTAI_TRACES_DIR=traces